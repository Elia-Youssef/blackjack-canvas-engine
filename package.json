{
  "name": "blackjack-canvas-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An accessible, deterministic HTML5 blackjack game built with strict TypeScript and Canvas 2D.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "verify:policy": "node scripts/check-repository-record.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . --ignore-pattern \"tests/lint/fixtures/**\"",
    "test": "vitest run",
    "test:browser": "playwright test",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "verify:build": "node scripts/check-determinism.mjs",
    "report:bundle-size": "node scripts/report/bundle-size.mjs",
    "report:touch-targets": "node scripts/report/touch-targets.mjs",
    "report:contrast": "node scripts/report/contrast.mjs",
    "report:perf": "node scripts/report/perf.mjs",
    "report:lighthouse": "npm install --no-save --no-package-lock --no-audit --no-fund lighthouse@13.4.1 && node scripts/report/lighthouse.mjs",
    "report:memory": "node scripts/report/memory.mjs",
    "report:all": "node scripts/report/all.mjs",
    "verify:reports": "npm run report:bundle-size && npm run report:contrast && npm run report:touch-targets && npm run report:perf",
    "verify:mutations": "node scripts/mutation-check.mjs",
    "verify": "npm run verify:policy && npm run typecheck && npm run lint && npm run test && npm run test:browser && npm run verify:build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
